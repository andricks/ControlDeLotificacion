# Copiar a .env y completar. NUNCA versionar .env
# MongoDB Atlas: Database > Connect > Drivers > Python (reemplazar <usuario> y <contrasena>)
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=facturas
MONGODB_DB=facturas
MONGODB_DB_TEST=facturas_test
# Firma de la cookie de sesión. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
# Inicio de sesión SOLO con Google (ADR-003). Google Cloud Console > APIs y servicios > Credenciales >
# ID de cliente OAuth (Aplicación web). Orígenes JS autorizados: http://localhost y http://localhost:5173
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Correos de Google que siempre entran como administrador (separados por coma)
ADMIN_CORREOS=tu-correo@gmail.com
SESION_HORAS=8
# true solo cuando el sistema se sirva por HTTPS
COOKIE_SEGURA=false
# desarrollo | produccion (produccion exige secreto fuerte, cookie segura y CORS https)
ENTORNO=desarrollo
CORS_ORIGENES=http://localhost:5173
STORAGE_DIR=./storage
MAX_MB_ARCHIVO=25
MAX_MB_PLANO=100
OCR_HABILITADO=false
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
ZONA_HORARIA=America/Guatemala